
{{> datatable}}

<template id="playlistContextMenuTemplate">
	<ul class="context-menu">
		{{#create_playlist_contextmenu}}
		<li>
			<a href="/playlists/settings/{{CREATE_PLAYLIST_MODE}}">{{LANG_CREATE_PLAYLIST_MODE}}</a>
		</li>
		{{/create_playlist_contextmenu}}
	</ul>
</template>

<template id="playlistsActionsContextMenuTemplate">
	{{#playlists_actions_contextmenu}}
	<ul class="context-menu">
		<li class="composer">
			<a href=""><i class="bi bi-pencil"></i> {{LANG_COMPOSE}}</a>
		</li>
		<li class="settings">
			<a href=""><i class="bi bi-gear"></i> {{LANG_SETTINGS}}</a>
		</li>
		<li class="share">
			<i class="bi bi-share"></i> {{LANG_SHARE}}
		</li>
		<li class="versions">
			<i class="bi bi-clock-history"></i> {{LANG_VERSIONS}}
		</li>
		<li class="delete" data-confirm="{{LANG_PLAYLIST_DELETE_CONFIRM}}">
			<i class="bi bi-trash"></i> {{LANG_PLAYLIST_DELETE}}
		</li>
	</ul>
	{{/playlists_actions_contextmenu}}
</template>
