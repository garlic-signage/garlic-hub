{{> datatable}}

<template id="playerActionsContextMenuTemplate">
	{{#player_actions_contextmenu}}
	<ul class="context-menu">
		<li class="assign">
			<i class="bi bi-list-ul"></i> {{LANG_ASSIGN_PLAYLIST}}
		</li>
		<li class="unassign">
			<i class="bi bi-x-circle"></i> {{LANG_UNASSIGN_PLAYLIST}}
		</li>
		<li class="push">
			<i class="bi bi-send"></i> {{LANG_PUSH_PLAYLIST}}
		</li>
		<li class="goto">
			<a href=""><i class="bi bi-box-arrow-up-right"></i> {{LANG_GOTO_PLAYLIST}}</a>
		</li>
		<li class="preview">
			<i class="bi bi-eye"></i> {{LANG_PREVIEW}}
		</li>
		<li class="share">
			<i class="bi bi-share"></i> {{LANG_SHARE}}
		</li>
		<li class="delete" data-confirm="{{LANG_PLAYER_DELETE_CONFIRM}}">
			<i class="bi bi-trash"></i> {{LANG_PLAYER_DELETE}}
		</li>
	</ul>
	{{/player_actions_contextmenu}}
</template>

<dialog id="playerPreviewDialog" class="player-preview">
	<header>
		<span class="dialog-name"></span>
		<button type="button" class="close-button bi bi-x" aria-label="Close"></button>
	</header>
	<div class="preview-frame"></div>
</dialog>

