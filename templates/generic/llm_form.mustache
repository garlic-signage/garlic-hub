<form action="{{FORM_ACTION}}" method="post" class="llm-form">
	<input type="hidden" name="csrf_token" value="{{CSRF_TOKEN}}">
	<label for="llm_api_type">{{LANG_API_TYPE}}</label>
	<select id="llm_api_type" name="api_type">
		{{#api_types}}
		<option value="{{VALUE}}"{{#is_selected}} selected{{/is_selected}}>{{LANG_VALUE}}</option>
		{{/api_types}}
	</select>
	<label for="llm_base_url">{{LANG_BASE_URL}}</label>
	<input type="url" id="llm_base_url" name="base_url" value="{{BASE_URL}}" maxlength="255" placeholder="https://api.openai.com/v1" required>
	<label for="llm_model">{{LANG_MODEL}}</label>
	<input type="text" id="llm_model" name="model" value="{{MODEL}}" maxlength="100" required>
	<label for="llm_api_key">{{LANG_API_KEY}}</label>
	<input type="password" id="llm_api_key" name="api_key" autocomplete="off" placeholder="{{API_KEY_HINT}}">
	{{#release}}
	<label for="llm_released_for">{{LANG_RELEASED_FOR}}</label>
	<select id="llm_released_for" name="released_for">
		{{#releases}}
		<option value="{{VALUE}}"{{#is_selected}} selected{{/is_selected}}>{{LANG_VALUE}}</option>
		{{/releases}}
	</select>
	{{/release}}
	<button type="submit" class="primary">{{LANG_SAVE}}</button>
</form>
{{#can_delete}}
<form action="{{DELETE_ACTION}}" method="post" class="llm-form">
	<input type="hidden" name="csrf_token" value="{{CSRF_TOKEN}}">
	<button type="submit">{{LANG_DELETE}}</button>
</form>
{{/can_delete}}
